# Copy this file to .env before running the Docker OpenSearch demo.
# The Java harness reads .env first; OS environment variables can override these
# values for CI or one-off local runs.

# OpenSearch connection for the reproducible paper experiment.
DATASET_MODE=synthetic
DATASET_ACTION=evaluate
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=log-anomaly-synthetic

# Keep false by default so mvn test remains deterministic without Docker.
# Set true when Docker OpenSearch is running and you want integration tests.
OPENSEARCH_INTEGRATION_ENABLED=false

# Embeddings.
# V1 intentionally uses deterministic embeddings so paper scenarios reproduce.
EMBEDDING_PROVIDER=deterministic-synthetic-v1

# OpenAI embeddings for planned public dataset validation.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# OpenStack LogHub one-time embedding/indexing plan.
OPENSTACK_LOGHUB_DIR=data/loghub/openstack
OPENSTACK_INDEX=log-anomaly-openstack
OPENSTACK_RECREATE_INDEX=false
OPENSTACK_EMBEDDING_CACHE=target/openstack-embedding-cache.jsonl
OPENSTACK_BATCH_SIZE=64
OPENSTACK_INDEX_BATCH_SIZE=1000
OPENSTACK_EXPERIMENT_ANCHOR=2026-01-01T00:00:00Z
OPENSTACK_SHORT_WINDOW_MINUTES=15
OPENSTACK_BASELINE_WINDOW_HOURS=24

# BGL LogHub one-time embedding/indexing plan.
BGL_LOGHUB_FILE=data/loghub/bgl/BGL.log
BGL_INDEX=log-anomaly-bgl
BGL_RECREATE_INDEX=false
BGL_EMBEDDING_CACHE=target/bgl-embedding-cache.jsonl
BGL_BATCH_SIZE=64
BGL_INDEX_BATCH_SIZE=1000
BGL_SHORT_WINDOW_MINUTES=15
BGL_BASELINE_WINDOW_HOURS=24
BGL_EVAL_BUCKET_MINUTES=5
BGL_CANDIDATE_MODE=filtered
BGL_EVAL_RANGE_MODE=contiguous
BGL_EVAL_START=
BGL_EVAL_DURATION_DAYS=14

# Experiment configuration used by mvn exec:java and integration tests.
EXPERIMENT_TOP_K=5
EXPERIMENT_SIMILARITY_THRESHOLD=0.85
EXPERIMENT_NOVELTY_THRESHOLD=3
EXPERIMENT_SPIKE_THRESHOLD=2.0
EXPERIMENT_SHORT_WINDOW_MINUTES=5
EXPERIMENT_BASELINE_WINDOW_MINUTES=55

# Paper metrics report.
REPORT_EXCEL_ENABLED=true
REPORT_OUTPUT_DIR=reports
REPORT_FILE_PREFIX=semantic-frequency-paper-test
LLM_EVALUATION_MODE=placeholder
