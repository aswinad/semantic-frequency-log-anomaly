# Copy this file to .env before running the Docker OpenSearch demo.
# The Java harness reads .env first; OS environment variables can override these
# values for CI or one-off local runs.

# OpenSearch connection for the reproducible paper experiment.
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=log-anomaly-synthetic

# Keep false by default so mvn test remains deterministic without Docker.
# Set true when Docker OpenSearch is running and you want integration tests.
OPENSEARCH_INTEGRATION_ENABLED=false

# Embeddings.
# V1 intentionally uses deterministic embeddings so paper scenarios reproduce.
EMBEDDING_PROVIDER=deterministic-synthetic-v1

# Experiment configuration used by mvn exec:java and integration tests.
EXPERIMENT_TOP_K=5
EXPERIMENT_SIMILARITY_THRESHOLD=0.85
EXPERIMENT_NOVELTY_THRESHOLD=3
EXPERIMENT_SPIKE_THRESHOLD=2.0
EXPERIMENT_SHORT_WINDOW_MINUTES=5
EXPERIMENT_BASELINE_WINDOW_MINUTES=55

# Paper metrics report.
REPORT_EXCEL_ENABLED=true
REPORT_OUTPUT_DIR=reports
REPORT_FILE_PREFIX=semantic-frequency-paper-test
LLM_EVALUATION_MODE=placeholder
